</Base>

<style>
  .notfound { min-height: 100vh; display: grid; place-content: center; justify-items: center; text-align: center; padding: 16px; gap: 8px; }
  h1 { font-size: 3rem; }
  p { margin: 0; color: var(--muted); }
</style>
