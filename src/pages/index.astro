---
import Base from "../layouts/Base.astro";
import { person, projects, talks, hobbies } from "../data/site";
---

<Base
  title={`${person.name}: ${person.tagline}`}
  description={person.summary}
>
  <a class="skip" href="#main">Skip to content</a>

  <header class="nav">
    <div class="container nav-inner">
      <a href="#top" class="logo" aria-label="Back to top">
        <img src="/images/mrbanana.png" alt="Mr Banana, my logo for the wild ride we're on with AI" width="56" height="56" />
      </a>
      <nav aria-label="Sections">
        <ul>
          <li><a href="#projects">Projects</a></li>
          <li><a href="#talks">Talks</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main id="main">
    <section class="hero" id="top">
      <div class="container hero-inner">
        <div class="hero-text">
          <p class="eyebrow hero-eyebrow">{person.role}</p>
          <h1>{person.name}</h1>
          <p class="tagline">Developer productivity in the age of <em>AI coding agents</em></p>
          <p class="summary">{person.summary}</p>
          <ul class="hero-links">
            <li><a class="btn primary" href={person.links.linkedin}>LinkedIn</a></li>
            <li><a class="btn" href={person.links.github}>GitHub</a></li>
          </ul>
        </div>
        <img class="portrait" src="/images/michael.jpg" alt="Portrait of Michael Müller" width="320" height="320" />
      </div>
    </section>

    <section id="about">
      <div class="container about">
        <p class="lead about-text">
          My career, current role and work experience are on LinkedIn. This page is the personal side: side projects and talks.
        </p>
        <a class="btn-outline" href={person.links.linkedin}>View my career on LinkedIn <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section id="projects">
      <div class="container">
        <p class="eyebrow">Side projects</p>
        <h2>Things I've built</h2>
        <p class="lead">Side projects are where I try new things first.</p>
        <div class="grid grid-3 projects">
          {projects.map((p) => (
            <article class="card project">
              <img src={p.image} alt={`Screenshot or logo of ${p.name}`} loading="lazy" width="400" height="225" />
              <div class="project-body">
                <h4>{p.name}</h4>
                <p>{p.description}</p>
                <p class="project-links">
                  <a href={p.repo}>Code</a>
                  {p.demo && <a href={p.demo}>Website</a>}
                </p>
                <ul class="tags">
                  {p.tech.map((t) => <li>{t}</li>)}
                </ul>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="talks">
      <div class="container">
        <p class="eyebrow">Talks</p>
        <h2>Sharing what I learn</h2>
        <p class="lead">Public talks and guest lectures from the last years.</p>
        <ul class="talks">
          {talks.map((t) => (
            <li class="card talk">
              <div>
                <h3>{t.title}</h3>
                <p class="venue">{t.venue}{t.year && ` · ${t.year}`}</p>
              </div>
              <p class="talk-links">
                {t.slides && <a href={t.slides}>Slides</a>}
                {t.video && <a href={t.video}>Video</a>}
              </p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="beyond">
      <div class="container beyond">
        <p class="eyebrow">Beyond work</p>
        <p class="hobbies">
          {hobbies.map((h) => <span>{h}</span>)}
        </p>
      </div>
    </section>
  </main>

  <footer>
    <div class="container footer-inner">
      <p>© {new Date().getFullYear()} {person.name} · {person.location}</p>
      <p>
        Static site built with <a href="https://astro.build">Astro</a> and a coding agent ·
        <a href="https://github.com/haimich/haimich.github.io">Source</a> ·
        <a href="/llms.txt">llms.txt</a>
      </p>
    </div>
  </footer>
</Base>

<style>
  .skip { position: absolute; left: -999px; top: 8px; background: var(--surface); padding: 8px 12px; border-radius: 8px; z-index: 100; }
  .skip:focus { left: 8px; }

  .nav {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--hero-bg) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid rgb(255 255 255 / 0.06);
  }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; height: 72px; }
  .logo img { width: 52px; height: 52px; transition: transform 0.3s ease; }
  .logo:hover img { transform: rotate(12deg) scale(1.06); }
  @media (prefers-reduced-motion: reduce) { .logo:hover img { transform: none; } }
  .nav ul { display: flex; gap: 4px; list-style: none; margin: 0; padding: 0; }
  .nav a:not(.logo) { color: var(--hero-text); text-decoration: none; font-size: 0.92rem; padding: 8px 10px; border-radius: 8px; }
  .nav a:not(.logo):hover { background: rgb(255 255 255 / 0.08); }

  .hero { background: radial-gradient(ellipse at 75% 30%, #3a414a 0%, var(--hero-bg) 65%); color: var(--hero-text); padding: 64px 0 80px; border-top: 0; }
  .hero-inner { display: grid; gap: 40px; align-items: center; }
  @media (min-width: 860px) { .hero-inner { grid-template-columns: 1fr auto; gap: 64px; } }
  .hero-eyebrow { color: var(--hero-accent); }
  .hero h1 { font-size: clamp(2.4rem, 6vw, 3.6rem); letter-spacing: -0.03em; }
  .tagline { font-size: clamp(1.3rem, 3vw, 1.8rem); font-weight: 600; margin: 12px 0 16px; letter-spacing: -0.01em; }
  .tagline em { font-style: normal; color: var(--hero-accent); }
  .summary { color: var(--hero-muted); max-width: 56ch; margin: 0 0 28px; }
  .hero-links { display: flex; flex-wrap: wrap; gap: 10px; list-style: none; padding: 0; margin: 0; }
  .btn {
    display: inline-block; padding: 10px 18px; border-radius: 999px; text-decoration: none; font-weight: 600; font-size: 0.95rem;
    color: var(--hero-text); border: 1px solid rgb(255 255 255 / 0.25);
  }
  .btn:hover { background: rgb(255 255 255 / 0.08); }
  .btn.primary { background: var(--hero-accent); color: #1f2328; border-color: var(--hero-accent); }
  .btn.primary:hover { filter: brightness(1.05); }
  .portrait { width: min(280px, 70vw); height: auto; aspect-ratio: 1; border-radius: 50%; border: 4px solid rgb(185 196 154 / 0.5); justify-self: center; }

  .card h3 { font-size: 1.15rem; margin-bottom: 8px; }
  .card p { margin: 0; }




  .projects { gap: 16px; }
  .project { padding: 0; overflow: hidden; display: flex; flex-direction: column; }
  .project img { width: 100%; height: 160px; object-fit: cover; background: var(--surface-2); border-bottom: 1px solid var(--border); }
  .project-body { padding: 16px 18px 18px; }
  .project h4 { margin: 0 0 6px; font-size: 1.02rem; }
  .project p { font-size: 0.93rem; color: var(--muted); }
  .project-links { display: flex; gap: 14px; margin-top: 8px !important; }
  .project .tags { margin-top: 10px; }

  .talks { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; }
  .talk { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 8px 24px; padding: 16px 20px; }
  .talk h3 { font-size: 1.05rem; margin: 0; }
  .venue { color: var(--muted); font-size: 0.92rem; }
  .talk-links { display: flex; gap: 14px; }

  .about { text-align: center; }
  .about-text { margin: 0 auto 20px; }
  .btn-outline { display: inline-block; padding: 10px 20px; border-radius: 999px; border: 1px solid var(--accent); text-decoration: none; font-weight: 600; }
  .btn-outline:hover { background: var(--accent-soft); }
  .beyond { text-align: center; }
  .hobbies { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin: 0; }
  .hobbies span { padding: 8px 16px; border: 1px solid var(--border); border-radius: 999px; background: var(--surface); }

  footer { border-top: 1px solid var(--border); padding: 28px 0 40px; color: var(--muted); font-size: 0.9rem; }
  .footer-inner { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; }
  footer p { margin: 0; }
</style>
